# 起動時に ${PORT} が Railway の PORT に置きかわる(nginx 公式イメージの templates 機能)
server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;

    # 注意: location の中で add_header を書くと、server の add_header は引き継がれない。
    # そのため、セキュリティ用のヘッダーは各 location に書く

    # ビルドのたびに名前が変わるファイルは、長くキャッシュしてよい
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        try_files $uri =404;
    }

    # index.html などは毎回確認させる(新しい版をすぐ反映するため)
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        try_files $uri $uri/ /index.html;
    }
}
